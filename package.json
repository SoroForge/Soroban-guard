{
  "name": "soroban-guard",
  "version": "0.0.1",
  "private": true,
  "description": "Safe upgrade framework for Soroban smart contracts — timelocks, multi-sig governance, migration testing, and rollback support",
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "upgrade",
    "governance",
    "timelock",
    "security"
  ],
  "homepage": "https://github.com/SoroForge/soroban-guard#readme",
  "bugs": {
    "url": "https://github.com/SoroForge/soroban-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SoroForge/soroban-guard.git"
  },
  "license": "MIT",
  "workspaces": [
    "sdk",
    "ui"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:contracts": "cd contracts && cargo build --target wasm32-unknown-unknown --release",
    "changeset": "changeset",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "turbo run test",
    "test:contracts": "cd contracts && cargo test",
    "typecheck": "turbo run typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "turbo": "^2.0.4",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9"
}
