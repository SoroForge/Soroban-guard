# ============================================================
# soroban-upgrade-guard — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Stellar Network
# Options: mainnet | testnet | futurenet | standalone
STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the chosen network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (auto-set by SDK if STELLAR_NETWORK is provided)
# STELLAR_NETWORK_PASSPHRASE=

# Deployer / admin account secret key (for deploy scripts only)
# STELLAR_SECRET=S...

# Deployed contract IDs (populated after running scripts/deploy.sh)
# TIMELOCK_CONTRACT_ID=C...
# GOVERNANCE_CONTRACT_ID=C...
# UPGRADE_PROXY_CONTRACT_ID=C...

# ── UI (ui/.env) ─────────────────────────────────────────────
# Copy the relevant vars below into ui/.env for the dashboard
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VITE_TIMELOCK_CONTRACT_ID=
VITE_GOVERNANCE_CONTRACT_ID=
